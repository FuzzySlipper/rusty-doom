{
  "name": "rusty-doom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "audit:boundary": "node scripts/check-canonical-projects.mjs",
    "build:shell": "bash scripts/build-product-ui.sh",
    "check:content": "pnpm --filter @loading-bay/e1m1-authoring compose:check && node scripts/check-canonical-projects.mjs && node scripts/generate-e1m1-asset-catalog.mjs --check",
    "check:e1m1-semantics": "node scripts/generate-e1m1-semantic-catalog.mjs --check",
    "generate:content": "pnpm --filter @loading-bay/e1m1-authoring generate",
    "lint": "nx run-many -t lint --all",
    "serve:den": "bash scripts/serve-den.sh",
    "test:ts": "pnpm --filter @loading-bay/e1m1-authoring test && node --test scripts/tests/e1m1-recipe-scan.test.mjs",
    "typecheck": "bash scripts/prepare-product-ui-types.sh && pnpm --filter @loading-bay/e1m1-authoring typecheck && nx run loading-bay:typecheck --skip-nx-cache",
    "verify": "bash scripts/verify.sh",
    "check:provenance": "pnpm --filter @loading-bay/e1m1-authoring check && python3 scripts/authoring/generate-recipe-sprites.py --check",
    "scan:e1m1-recipes": "node scripts/scan-e1m1-recipes.mjs",
    "test:e1m1-recipes": "node --test scripts/tests/e1m1-recipe-scan.test.mjs"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@eslint/js": "^9.39.4",
    "@nx/angular": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@types/node": "25.9.2",
    "@typescript-eslint/utils": "^8.61.1",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.61.1"
  }
}
