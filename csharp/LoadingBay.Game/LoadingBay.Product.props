<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductUiSourceRoot>$(MSBuildThisFileDirectory)../../apps/loading-bay/src</RustyEngineProductUiSourceRoot>
    <RustyEngineProductUiBuildCommand>bash &quot;$(MSBuildThisFileDirectory)../../scripts/build-product-ui.sh&quot; &quot;$(RustyEngineProductUiTypes)&quot;</RustyEngineProductUiBuildCommand>
    <RustyEngineProductUiRoot>$(MSBuildThisFileDirectory)../../dist/apps/loading-bay/browser</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$(MSBuildThisFileDirectory)../../content</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>loading-bay.hud</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>loading-bay.hud.snapshot.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductRenderOutput>stream</RustyEngineProductRenderOutput>
    <RustyEngineProductAudioOutput>device-optional</RustyEngineProductAudioOutput>
    <RustyEngineProductInputCursorMode>pointer-lock</RustyEngineProductInputCursorMode>
    <RustyEngineProductDefaultWorldLights>neutral</RustyEngineProductDefaultWorldLights>
    <RustyEngineProductDefaultViewmodelLights>neutral</RustyEngineProductDefaultViewmodelLights>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEnginePackageExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</RustyEnginePackageExcludeAssets>
  </PropertyGroup>

  <ItemGroup>
    <RustyEngineProductUiInput Include="$(MSBuildThisFileDirectory)../../apps/loading-bay/project.json;$(MSBuildThisFileDirectory)../../apps/loading-bay/tsconfig*.json;$(MSBuildThisFileDirectory)../../tsconfig.angular.json;$(MSBuildThisFileDirectory)../../package.json;$(MSBuildThisFileDirectory)../../pnpm-lock.yaml;$(MSBuildThisFileDirectory)../../scripts/build-product-ui.sh;$(MSBuildThisFileDirectory)../../scripts/prepare-product-ui-types.sh;$(RustyEngineProductUiTypes)" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" ExcludeAssets="$(RustyEnginePackageExcludeAssets)" />
    <RustyEngineProductInputIntent Include="player.move.forward" Value="digital" />
    <RustyEngineProductInputIntent Include="player.move.left" Value="digital" />
    <RustyEngineProductInputIntent Include="player.move.backward" Value="digital" />
    <RustyEngineProductInputIntent Include="player.move.right" Value="digital" />
    <RustyEngineProductInputIntent Include="player.jump" Value="digital" />
    <RustyEngineProductInputIntent Include="player.use" Value="digital" />
    <RustyEngineProductInputIntent Include="player.fire" Value="digital" />
    <RustyEngineProductInputIntent Include="player.look.x" Value="axis" />
    <RustyEngineProductInputIntent Include="player.look.y" Value="axis" />
    <RustyEngineProductInputMapping Include="player.move.forward" Intent="player.move.forward" Trigger="key:key-w:held" />
    <RustyEngineProductInputMapping Include="player.move.left" Intent="player.move.left" Trigger="key:key-a:held" />
    <RustyEngineProductInputMapping Include="player.move.backward" Intent="player.move.backward" Trigger="key:key-s:held" />
    <RustyEngineProductInputMapping Include="player.move.right" Intent="player.move.right" Trigger="key:key-d:held" />
    <RustyEngineProductInputMapping Include="player.jump" Intent="player.jump" Trigger="key:space:pressed" />
    <RustyEngineProductInputMapping Include="player.use" Intent="player.use" Trigger="key:key-e:pressed" />
    <RustyEngineProductInputMapping Include="player.fire" Intent="player.fire" Trigger="pointer-button:primary:pressed" />
    <RustyEngineProductInputMapping Include="player.fire.ctrl" Intent="player.fire" Trigger="key:control-left:pressed" />
    <RustyEngineProductInputMapping Include="player.look.x" Intent="player.look.x" Trigger="pointer-axis:x" />
    <RustyEngineProductInputMapping Include="player.look.y" Intent="player.look.y" Trigger="pointer-axis:y" />
    <RustyEngineProductInputIntent Include="player.move.analog-x" Value="axis" />
    <RustyEngineProductInputIntent Include="player.move.analog-y" Value="axis" />
    <RustyEngineProductInputMapping Include="player.move.left-stick-x" Intent="player.move.analog-x" Trigger="controller-axis:axis-0" />
    <RustyEngineProductInputMapping Include="player.move.left-stick-y" Intent="player.move.analog-y" Trigger="controller-axis:axis-1" />
    <RustyEngineProductInputMapping Include="player.look.right-stick-x" Intent="player.look.x" Trigger="controller-axis:axis-2" />
    <RustyEngineProductInputMapping Include="player.look.right-stick-y" Intent="player.look.y" Trigger="controller-axis:axis-3" />
    <RustyEngineProductInputMapping Include="player.jump.controller-a" Intent="player.jump" Trigger="controller-button:button-0:held" />
    <RustyEngineProductInputMapping Include="player.use.controller-x" Intent="player.use" Trigger="controller-button:button-2:pressed" />
    <RustyEngineProductInputMapping Include="player.fire.controller-rt" Intent="player.fire" Trigger="controller-button:button-7:pressed" />
    <RustyEngineProductInputIntent Include="player.look.left" Value="digital" />
    <RustyEngineProductInputMapping Include="player.look.left" Intent="player.look.left" Trigger="key:key-j:held" />
    <RustyEngineProductInputIntent Include="player.look.right" Value="digital" />
    <RustyEngineProductInputMapping Include="player.look.right" Intent="player.look.right" Trigger="key:key-l:held" />
    <RustyEngineProductInputIntent Include="player.look.up" Value="digital" />
    <RustyEngineProductInputMapping Include="player.look.up" Intent="player.look.up" Trigger="key:key-i:held" />
    <RustyEngineProductInputIntent Include="player.look.down" Value="digital" />
    <RustyEngineProductInputMapping Include="player.look.down" Intent="player.look.down" Trigger="key:key-k:held" />
    <RustyEngineProductInputIntent Include="player.look.precision" Value="digital" />
    <RustyEngineProductInputMapping Include="player.look.precision" Intent="player.look.precision" Trigger="key:shift-left:held" />
    <RustyEngineProductInputIntent Include="player.restart" Value="digital" />
    <RustyEngineProductInputMapping Include="player.restart" Intent="player.restart" Trigger="key:key-r:pressed" />
  </ItemGroup>
</Project>
