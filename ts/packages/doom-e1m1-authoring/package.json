{
  "name": "@loading-bay/e1m1-authoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "check": "node scripts/check-retained-content.mjs",
    "compose:check": "node scripts/check-retained-content.mjs",
    "generate": "node scripts/check-retained-content.mjs",
    "sprites:check": "tsc --build && node dist/sprite-cli.js --check",
    "sprites:generate": "tsc --build && node dist/sprite-cli.js --write",
    "test": "tsc --build && node --test dist/*.test.js",
    "typecheck": "tsc --build",
    "sounds:check": "tsc --build && node dist/sound-cli.js --check",
    "sounds:generate": "tsc --build && node dist/sound-cli.js --write"
  }
}
